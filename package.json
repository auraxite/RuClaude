{
  "name": "ruclaude-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "RuClaude privacy guard and country-based access check for Claude on Chromium, Firefox and Android",
  "scripts": {
    "build": "npm run build:browser",
    "build:browser": "npm --prefix browser run build",
    "build:chromium": "npm --prefix browser run build:chromium",
    "build:firefox": "npm --prefix browser run build:firefox",
    "test": "npm --prefix browser test"
  }
}
