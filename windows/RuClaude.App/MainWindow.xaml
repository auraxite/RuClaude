<Window x:Class="RuClaude.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RuClaude" Width="540" Height="475"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="White"
        FontFamily="Segoe UI" Icon="pack://application:,,,/Assets/ruclaude.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="26,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="pack://application:,,,/Assets/logo.png" Width="58" Height="58" Margin="0,0,15,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="RuClaude" FontSize="29" FontWeight="Bold" />
        <TextBlock x:Name="Subtitle" Foreground="{StaticResource SubtleBrush}" FontSize="12" Text="Country-based network filter"/>
      </StackPanel>
      <Button Grid.Column="2" x:Name="LanguageButton" Content="РУ" Click="LanguageButton_Click"
              Width="54" Height="38" VerticalAlignment="Center"
              ToolTip="Переключить язык / Switch language"/>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="SwitchTitle" FontSize="17" FontWeight="Bold" Text="Защита" />
          <TextBlock x:Name="SwitchSub" Foreground="{StaticResource SubtleBrush}" FontSize="12" Text="Контроль страны публичного IP" Margin="0,5,0,0" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="ToggleButton" Width="115" Height="46" FontSize="17" Content="ON" Click="ToggleButton_Click"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4">
      <TextBlock x:Name="CountryLabel" Text="Разрешённая страна" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
      <ComboBox x:Name="CountryPicker" Height="44" FontSize="15" Background="White" Foreground="#172033"
                DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="CountryPicker_SelectionChanged" />
      <TextBlock x:Name="SavedLabel" Text="Сохраняется автоматически" Foreground="{StaticResource SubtleBrush}" FontSize="12" Margin="0,10,0,0" />
    </StackPanel>

    <Border Grid.Row="6" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16,10">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusTitle" Text="Состояние фильтра" FontSize="16" FontWeight="SemiBold"/>
          <Button x:Name="RefreshButton" Grid.Column="1" Content="↻" Width="44" Height="34" FontSize="21" Cursor="Hand" ToolTip="Проверить IP сейчас" Padding="8,0" Click="RefreshButton_Click"/>
        </Grid>
        <TextBlock x:Name="StatusValue" Text="Проверка службы..." FontSize="18" FontWeight="Bold" Margin="0,3,0,2" Foreground="#F1BC68"/>
        <TextBlock x:Name="IpValue" Text="" FontSize="12" Foreground="{StaticResource SubtleBrush}"/>
        <TextBlock x:Name="StatusDetail" Text="" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="8" Margin="0,0,0,0">
      <TextBlock x:Name="Footnote" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,0" Text="Служба работает в фоновом режиме" />
    </StackPanel>
  </Grid></ScrollViewer>
</Window>
