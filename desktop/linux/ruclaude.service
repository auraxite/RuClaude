[Unit]
Description=RuClaude Qt6 country checker and nftables service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=ruclaude
ExecStart=/opt/ruclaude/bin/RuClaudeService
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ruclaude
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
