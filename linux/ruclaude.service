[Unit]
Description=RuClaude IP country checking and nftables filtering
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=ruclaude
ExecStart=/usr/bin/python3 /opt/ruclaude/service.py
Restart=always
RestartSec=3
RuntimeDirectory=ruclaude
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/ruclaude
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
